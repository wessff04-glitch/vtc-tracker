rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Les chauffeurs peuvent lire leurs propres données
    match /chauffeurs/{userId} {
      // Autoriser la lecture/maj au propriétaire, et permettre aux admins
      // (utilisateurs dont le doc chauffeurs/{auth.uid}.role == 'admin')
      // de lire les documents des chauffeurs.
      allow read, update: if request.auth != null && (
        request.auth.uid == userId ||
        // Le get() vérifie le document du demandeur pour son rôle
        (get(/databases/$(database)/documents/chauffeurs/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Pour l'instant, on bloque tout le reste en attendant les règles détaillées
    match /sessions/{sessionId} {
      // Les chauffeurs authentifiés peuvent créer leurs sessions et lire/mettre à jour
      allow create: if request.auth != null && request.resource.data.chauffeur_id == request.auth.uid;
      // Lecture autorisée pour le propriétaire ou pour un admin
      allow read: if request.auth != null && (
        resource.data.chauffeur_id == request.auth.uid ||
        get(/databases/$(database)/documents/chauffeurs/$(request.auth.uid)).data.role == 'admin'
      );
      // Seul le propriétaire peut mettre à jour ou supprimer
      allow update, delete: if request.auth != null && resource.data.chauffeur_id == request.auth.uid;
    }

    match /courses/{courseId} {
      // Les chauffeurs authentifiés peuvent créer et lire leurs propres courses
      allow create: if request.auth != null && request.resource.data.chauffeur_id == request.auth.uid;
      // Lecture autorisée pour le propriétaire ou pour un admin
      allow read: if request.auth != null && (
        resource.data.chauffeur_id == request.auth.uid ||
        get(/databases/$(database)/documents/chauffeurs/$(request.auth.uid)).data.role == 'admin'
      );
      // Seul le propriétaire peut mettre à jour ou supprimer
      allow update, delete: if request.auth != null && resource.data.chauffeur_id == request.auth.uid;
    }
  }
}